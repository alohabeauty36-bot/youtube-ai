# ===== EV Creator Studio — file này KHÔNG bắt buộc. Key API nhập trong ứng dụng: Thiết lập → Cấu hình API. =====
# Chỉ dùng .env cho cấu hình hạ tầng (DATABASE_URL, thư mục) hoặc khi triển khai tự động. Giá trị trong giao diện ghi đè file này.
# demo: adapter giả lập có nhãn DEMO, không upload thật | production: tích hợp thật, thiếu key → BLOCKED_BY_CREDENTIALS
APP_MODE=demo
DATABASE_URL=sqlite:///./data/ev_studio.db
# DATABASE_URL=postgresql+psycopg://evcs:evcs@postgres:5432/evcs
PUBLIC_BASE_URL=http://localhost:8010
FRONTEND_BASE_URL=http://localhost:3000

# Bảo mật (bắt buộc ở production). Tạo: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_TOKEN=
EDITOR_TOKEN=

# Anthropic (API chính thức; đăng ký Claude web KHÔNG bao gồm quyền API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=16000

# VieNeu-TTS: auto | demo | vieneu_local | vieneu_http
TTS_PROVIDER=auto
VIENEU_MODE=v3turbo
VIENEU_BACKEND=            # để trống = tự chọn; "onnx" = ép CPU
VIENEU_HTTP_URL=http://localhost:8001
VIENEU_VOICE=Quang Sơn

# Media hợp quyền
PEXELS_API_KEY=
WIKIMEDIA_ENABLED=true
WIKIMEDIA_USER_AGENT=EVCreatorStudio/1.0 (contact: ban@example.com)

# YouTube (OAuth 2.0 — client "Web application" tạo ở Google Cloud Console, bật YouTube Data API v3)
GOOGLE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
YOUTUBE_EXPECTED_CHANNEL_ID=       # UC… của kênh đích; kênh khác sẽ bị chặn
YOUTUBE_MADE_FOR_KIDS_CONFIRMED_FALSE=false   # chỉ đặt true khi chủ kênh xác nhận nội dung KHÔNG dành cho trẻ em
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=        # chat_id của chủ kênh, phân tách bằng dấu phẩy
TELEGRAM_WEBHOOK_SECRET=          # để trống khi chạy local → dùng long-polling

# Biên tập & lịch
DURATION_TARGET_SECONDS=660
DURATION_MIN_SECONDS=600
DURATION_MAX_SECONDS=720
SCORE_AUTOPILOT=80
MAX_VIDEOS_PER_WEEK=3
SCAN_INTERVAL_HOURS=3

# Job
JOB_EXECUTOR=inline               # inline | celery
REDIS_URL=redis://localhost:6379/0
JOB_CONCURRENCY=2
RENDER_PRESET=veryfast

# --- Ngân sách AI (Ban Tài chính) — có thể chỉnh trong Thiết lập ---
BUDGET_MONTHLY_USD=50
BUDGET_STORY_MAX_USD=0.75
STORIES_PER_DAY=3
# MODEL_PRICES_JSON={"ten-model-chatgpt": [gia_vao, gia_ra]}

# --- Bộ não phòng ban ---
# TEACHER_STRATEGY=anthropic          # anthropic | openai | alternate
# MODEL_CLAIMS=claude-haiku-5-5
# MODEL_RESEARCH=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=
# LOCAL_LLM_URL=http://localhost:11434   # Ollama — để trống nếu chưa cài
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
